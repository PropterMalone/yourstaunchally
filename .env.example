# Setup (Tier 2 direnv): real secrets live at
#   ~/.local/share/secrets/yourstaunchally.env (mode 600)
# .envrc loads them via `dotenv_if_exists`. Repo's .env is a symlink to that
# central file (Docker `env_file: .env` requires a real path).
#
# First-time setup:
#   cp .env.example ~/.local/share/secrets/yourstaunchally.env
#   chmod 600 ~/.local/share/secrets/yourstaunchally.env
#   ln -s ~/.local/share/secrets/yourstaunchally.env .env
#   direnv allow .

BSKY_IDENTIFIER=
BSKY_PASSWORD=
LIVE_DMS=
DB_PATH=
PYTHON_PATH=
FEED_HOSTNAME=
FEED_PUBLISHER_DID=
FEED_BOT_DID=
# Optional: old account for DM forwarding during migration
OLD_BSKY_IDENTIFIER=
OLD_BSKY_PASSWORD=
# Labeler (optional — propter-labeler service for game post filtering)
LABELER_URL=http://labeler:4100
LABELER_SECRET=
